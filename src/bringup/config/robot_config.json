{
  "schema_version": 1,
  "label": "Cobra Flex",
  "default_video_rate_hz": 30,
  "control": {
    "scope": "robot",
    "ownership": "portal_active_operator"
  },
  "control_interfaces": {
    "base": {
      "label": "Rover",
      "frame_id": "base_link",
      "operations": {
        "drive": {
          "profile": "base.twist.v1",
          "command": {
            "track_name": "/cmd_vel",
            "msg_type": "geometry_msgs/msg/Twist",
            "format": "json"
          },
          "presentations": ["gamepad", "joystick", "keyboard"]
        }
      }
    },
    "head": {
      "label": "Camera head",
      "joint_names": ["pan_joint", "tilt_joint"],
      "operations": {
        "joint_velocity": {
          "profile": "joints.velocity_jog.v1",
          "command": {
            "track_name": "/head/joint_jog",
            "msg_type": "control_msgs/msg/JointJog",
            "format": "json"
          },
          "feedback_tracks": ["/joint_states"],
          "presentations": ["gamepad", "joint_sliders"]
        }
      }
    }
  },
  "exclude_data_tracks": [],
  "exclude_video_tracks": [],
  "exclude_audio_tracks": []
}
